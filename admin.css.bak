:root{
  color-scheme:dark;
  font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  --bg:#070a10;
  --panel:rgba(15,20,30,.82);
  --panel-strong:#111722;
  --panel-soft:rgba(18,24,35,.62);
  --border:rgba(255,255,255,.095);
  --border-strong:rgba(129,143,255,.28);
  --text:#f6f8ff;
  --muted:#8f9bb0;
  --muted-2:#667287;
  --primary:#7684ff;
  --primary-2:#9b72ff;
  --danger:#ff6f7d;
  --success:#65e6a8;
  --shadow:0 24px 70px rgba(0,0,0,.36);
}
*{box-sizing:border-box}
html{background:var(--bg)}
body{margin:0;min-height:100vh;background:
  radial-gradient(circle at 14% -10%,rgba(91,105,255,.15),transparent 30%),
  radial-gradient(circle at 92% 18%,rgba(140,81,255,.10),transparent 26%),
  linear-gradient(180deg,#080b12 0%,#070a10 50%,#06080d 100%);color:var(--text);overflow-x:hidden}
button,input,select{font:inherit}
button,select,input{outline:none}
button{border:0}
.ambient{position:fixed;width:420px;height:420px;border-radius:50%;filter:blur(110px);opacity:.13;pointer-events:none;z-index:0}
.ambient-a{top:-150px;left:-120px;background:#6676ff}
.ambient-b{right:-170px;top:32%;background:#8d55ff}
.shell{position:relative;z-index:1;width:min(1460px,calc(100% - 36px));margin:auto;padding:42px 0 70px}
.hidden{display:none!important}
.card{border:1px solid var(--border);border-radius:28px;background:linear-gradient(180deg,rgba(18,24,35,.94),rgba(11,15,23,.94));box-shadow:var(--shadow);backdrop-filter:blur(18px)}
.login{position:relative;overflow:hidden;width:min(460px,100%);margin:8vh auto;padding:34px}
.loginGlow{position:absolute;inset:-120px -160px auto auto;width:300px;height:300px;background:#707dff;border-radius:50%;filter:blur(90px);opacity:.13;pointer-events:none}
.eyebrow{color:#98a4ff;font-size:11px;font-weight:900;letter-spacing:.18em}
h1{font-size:clamp(34px,5vw,54px);line-height:1;margin:8px 0 10px;letter-spacing:-.04em}
p{color:var(--muted);line-height:1.55}
code{font-family:"SFMono-Regular",Consolas,monospace}
form{display:grid;gap:14px;margin-top:24px}
.field{display:grid;gap:8px}.field>span{font-size:12px;font-weight:750;color:#adb6c7}
input,select{border:1px solid var(--border);border-radius:14px;background:rgba(7,10,16,.78);color:#fff;transition:.2s ease}
input{padding:13px 15px}
input:focus,select:focus{border-color:rgba(118,132,255,.55);box-shadow:0 0 0 4px rgba(118,132,255,.09)}
button{border:1px solid var(--border);border-radius:13px;padding:11px 14px;background:linear-gradient(180deg,#1a2130,#151b27);color:#fff;cursor:pointer;font-weight:780;transition:transform .16s ease,border-color .16s ease,background .16s ease,box-shadow .16s ease,opacity .16s ease}
button:hover{transform:translateY(-1px);border-color:rgba(255,255,255,.17);background:linear-gradient(180deg,#222a3a,#181f2c)}
button:active{transform:translateY(0) scale(.98)}
button.primary,form button{border-color:rgba(140,150,255,.45);background:linear-gradient(135deg,#6d7cff,#875fff);box-shadow:0 12px 34px rgba(103,118,255,.20)}
.error{min-height:20px;margin-top:12px;color:#ff8996;font-size:13px}
.dashboard{animation:fadeIn .32s ease}
@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.topbar{display:flex;justify-content:space-between;gap:22px;align-items:flex-start;margin-bottom:26px}
.titleRow{display:flex;align-items:center;gap:13px;flex-wrap:wrap}.titleRow h1{margin-bottom:6px}
.topbar p{margin:0;color:var(--muted)}
.actions{display:flex;gap:9px;flex-wrap:wrap}.iconButton{display:inline-flex;align-items:center;gap:7px}.dangerGhost{color:#ffb0b8}
.liveBadge{display:inline-flex;align-items:center;gap:7px;border:1px solid rgba(101,230,168,.16);background:rgba(101,230,168,.07);color:#93f2c2;border-radius:999px;padding:6px 9px;font-size:11px;font-weight:850;letter-spacing:.03em}
.liveBadge i{width:7px;height:7px;border-radius:50%;background:#65e6a8;box-shadow:0 0 0 4px rgba(101,230,168,.08),0 0 13px rgba(101,230,168,.65)}
.stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px;margin:0 0 14px}
.statCard{position:relative;overflow:hidden;min-height:132px;padding:20px;border:1px solid var(--border);border-radius:20px;background:linear-gradient(145deg,rgba(17,23,34,.90),rgba(10,14,22,.84));box-shadow:0 12px 40px rgba(0,0,0,.13)}
.statCard:before{content:"";position:absolute;right:-20px;top:-50px;width:140px;height:140px;border-radius:50%;background:rgba(116,130,255,.10);filter:blur(20px)}
.statCard>span{position:relative;color:#7f8ca3;font-size:10px;font-weight:900;letter-spacing:.16em}.statCard strong{position:relative;display:block;font-size:clamp(23px,3vw,34px);margin-top:13px;letter-spacing:-.035em}.statCard small{position:relative;display:block;margin-top:4px;color:#788499}
.controlPanel{display:flex;align-items:end;justify-content:space-between;gap:14px;margin-bottom:15px;padding:12px;border:1px solid var(--border);border-radius:20px;background:rgba(13,18,27,.68);backdrop-filter:blur(14px)}
.searchWrap{position:relative;flex:1;min-width:220px}.searchWrap input{width:100%;height:46px;padding-left:42px;padding-right:42px;background:#0a0e15}.searchIcon{position:absolute;left:15px;top:50%;transform:translateY(-50%);font-size:20px;color:#6f7b91;pointer-events:none}.clearSearch{position:absolute;right:7px;top:7px;width:32px;height:32px;padding:0;border-radius:10px;background:transparent;color:#98a3b7}
.controls{display:flex;align-items:end;gap:10px;flex-wrap:wrap}.selectControl{display:grid;gap:5px}.selectControl>span{font-size:10px;font-weight:850;letter-spacing:.08em;color:#758197}.selectControl select{height:46px;padding:0 36px 0 13px;min-width:148px}
.toggleControl{height:46px;display:flex;align-items:center;gap:9px;padding:0 12px;border:1px solid var(--border);border-radius:14px;background:#0a0e15;cursor:pointer}.toggleControl input{position:absolute;opacity:0;pointer-events:none}.toggleUi{position:relative;width:35px;height:20px;border-radius:999px;background:#262e3d;transition:.2s}.toggleUi:after{content:"";position:absolute;top:3px;left:3px;width:14px;height:14px;border-radius:50%;background:#a6afbd;transition:.2s}.toggleControl input:checked+.toggleUi{background:#6877f1}.toggleControl input:checked+.toggleUi:after{left:18px;background:white}.toggleText{font-size:12px;font-weight:770;color:#aeb7c7}
.filterInfo{margin:4px 0 13px;color:#8e99ac;font-size:13px}.filterInfo strong{color:#d7dcff}
.gallery{--card-min:250px;display:grid;grid-template-columns:repeat(auto-fill,minmax(var(--card-min),1fr));gap:14px}.gallery.compact{--card-min:190px;gap:10px}.gallery.large{--card-min:340px;gap:18px}
.photo{position:relative;overflow:hidden;border:1px solid var(--border);border-radius:20px;background:linear-gradient(180deg,#101620,#0d121b);box-shadow:0 10px 32px rgba(0,0,0,.14);transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease}.photo:hover{transform:translateY(-3px);border-color:rgba(134,145,255,.28);box-shadow:0 18px 46px rgba(0,0,0,.24)}
.imageWrap{position:relative;overflow:hidden;background:#05070a}.thumb{width:100%;aspect-ratio:16/10;display:block;object-fit:cover;background:#05070a;cursor:zoom-in;transition:transform .28s ease,filter .25s ease}.photo:hover .thumb{transform:scale(1.022);filter:brightness(1.03)}
.imageOverlay{position:absolute;inset:0;display:flex;align-items:flex-end;justify-content:space-between;padding:10px;background:linear-gradient(180deg,transparent 45%,rgba(0,0,0,.54));opacity:0;transition:.2s;pointer-events:none}.photo:hover .imageOverlay{opacity:1}.imageOverlay span{padding:5px 8px;border:1px solid rgba(255,255,255,.12);border-radius:999px;background:rgba(0,0,0,.42);backdrop-filter:blur(8px);font-size:10px;font-weight:800;color:#e8ecf6}
.meta{padding:13px}.fileName{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px;color:#dbe1ec;font-weight:780}.metaLine{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:7px}.meta small{color:#7f8b9f}.cardActions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px}.cardActions button{padding:9px 10px;font-size:12px}.downloadCard{color:#dce2ff}.removeCard{color:#ffacb5}
.empty{padding:56px;border:1px dashed #303847;border-radius:20px;color:#8e98aa;text-align:center;background:rgba(13,17,25,.44)}
.viewerDialog{width:min(1500px,calc(100% - 18px));height:min(94vh,980px);max-width:none;max-height:none;padding:0;border:1px solid rgba(255,255,255,.12);border-radius:24px;background:#070a0f;overflow:hidden;box-shadow:0 36px 110px rgba(0,0,0,.7)}
.viewerDialog::backdrop{background:rgba(0,0,0,.84);backdrop-filter:blur(9px)}
.viewerShell{height:100%;display:grid;grid-template-rows:auto 1fr;min-height:0}.viewerTopbar{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:13px 14px 13px 18px;border-bottom:1px solid var(--border);background:rgba(13,18,27,.94)}.viewerTitle{min-width:0;display:grid;gap:4px}.viewerTitle strong{max-width:min(60vw,760px);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:14px}.viewerActions{display:flex;gap:8px}.viewerActions button{height:40px;padding:0 13px}.viewerActions .close{width:40px;padding:0;border-radius:12px;font-size:22px}
.viewerBody{display:grid;grid-template-columns:250px 1fr;min-height:0}.viewerSidebar{overflow:auto;padding:16px;border-right:1px solid var(--border);background:linear-gradient(180deg,#0d121b,#0a0e15)}.infoGroup{display:grid;gap:8px}.infoLabel,.shortcuts>span{font-size:10px;font-weight:900;letter-spacing:.13em;color:#6f7b90}.infoGroup strong{font-size:13px;line-height:1.4;word-break:break-word}.copyButton{width:max-content;padding:7px 9px;border-radius:9px;font-size:11px;color:#b9c2d3}.infoGrid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:18px}.infoGrid>div{min-width:0;padding:10px;border:1px solid var(--border);border-radius:12px;background:#0a0f17}.infoGrid span,.pathBox>span{display:block;color:#6f7b90;font-size:9px;font-weight:850;letter-spacing:.08em}.infoGrid strong{display:block;margin-top:5px;font-size:11px;word-break:break-word}.pathBox{margin-top:9px;padding:11px;border:1px solid var(--border);border-radius:12px;background:#0a0f17}.pathBox code{display:block;margin:6px 0 9px;color:#adb7c9;font-size:10px;line-height:1.5;word-break:break-all}.shortcuts{display:grid;gap:7px;margin-top:20px;padding-top:17px;border-top:1px solid var(--border)}.shortcuts small{display:flex;align-items:center;gap:5px;color:#7f8a9d}.shortcuts kbd{min-width:22px;padding:3px 5px;border:1px solid #2a3342;border-bottom-color:#394456;border-radius:6px;background:#121824;color:#d8deea;text-align:center;font-size:10px}
.imageStageWrap{display:grid;grid-template-rows:1fr auto;min-width:0;min-height:0;background:#05070a}.imageStage{position:relative;overflow:hidden;min-height:0;touch-action:none;cursor:default;background-image:linear-gradient(45deg,#070a0f 25%,transparent 25%),linear-gradient(-45deg,#070a0f 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#070a0f 75%),linear-gradient(-45deg,transparent 75%,#070a0f 75%);background-size:28px 28px;background-position:0 0,0 14px,14px -14px,-14px 0;background-color:#090d13}.imageStage.isPanning{cursor:grabbing}.imageTransform{position:absolute;left:50%;top:50%;transform-origin:center center;will-change:transform}.imageTransform img{display:block;max-width:none;max-height:none;user-select:none;-webkit-user-drag:none;box-shadow:0 18px 60px rgba(0,0,0,.32)}
.imageLoading{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;gap:10px;background:rgba(4,7,11,.68);backdrop-filter:blur(5px);color:#aab4c5;font-size:13px;z-index:8}.imageLoading span{width:18px;height:18px;border:2px solid #333d50;border-top-color:#8492ff;border-radius:50%;animation:spin .7s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}
.navButton{position:absolute;top:50%;z-index:6;width:44px;height:62px;padding:0;transform:translateY(-50%);border-radius:14px;background:rgba(9,13,20,.72);backdrop-filter:blur(12px);font-size:30px;color:#dce2ed}.navButton:hover{transform:translateY(-50%) scale(1.03)}.navButton.prev{left:12px}.navButton.next{right:12px}.navButton:disabled{opacity:.25;cursor:not-allowed;transform:translateY(-50%)}
.zoomHint{position:absolute;left:50%;bottom:12px;transform:translateX(-50%);z-index:5;padding:7px 10px;border:1px solid rgba(255,255,255,.10);border-radius:999px;background:rgba(7,10,15,.64);backdrop-filter:blur(12px);color:#7f899a;font-size:10px;pointer-events:none;transition:.3s}.imageStage:hover .zoomHint{color:#aeb7c6}
.viewerToolbar{display:flex;align-items:center;justify-content:center;gap:7px;min-height:58px;padding:9px;border-top:1px solid var(--border);background:#0c1119;overflow-x:auto}.viewerToolbar button{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-width:38px;height:38px;padding:0 10px;border-radius:10px}.viewerToolbar .zoomValue{min-width:67px;font-size:11px}.toolDivider{width:1px;height:25px;background:#252d3a;margin:0 2px}
.toast{position:fixed;left:50%;bottom:24px;z-index:9999;max-width:min(90vw,520px);padding:11px 14px;border:1px solid rgba(255,255,255,.12);border-radius:12px;background:rgba(15,20,30,.94);box-shadow:0 18px 48px rgba(0,0,0,.35);backdrop-filter:blur(14px);color:#edf1f8;font-size:12px;opacity:0;pointer-events:none;transform:translate(-50%,12px);transition:.22s ease}.toast.show{opacity:1;transform:translate(-50%,0)}
@media(max-width:900px){.viewerBody{grid-template-columns:1fr}.viewerSidebar{display:none}.viewerBody.showInfo .viewerSidebar{display:block;position:absolute;left:0;top:65px;bottom:58px;z-index:15;width:min(310px,88vw);box-shadow:22px 0 60px rgba(0,0,0,.45)}.stats{grid-template-columns:1fr 1fr}.statCard:last-child{grid-column:1/-1}.controlPanel{align-items:stretch;flex-direction:column}.controls{width:100%}.selectControl{flex:1}.selectControl select{width:100%}.viewerDialog{height:96vh;width:calc(100% - 10px);border-radius:18px}.viewerActions span{display:none}}
@media(max-width:620px){.shell{width:min(100% - 20px,1460px);padding-top:24px}.topbar{align-items:stretch;flex-direction:column}.actions{width:100%}.actions button{flex:1}.stats{grid-template-columns:1fr}.statCard:last-child{grid-column:auto}.controls{display:grid;grid-template-columns:1fr 1fr}.toggleControl{grid-column:1/-1}.gallery{--card-min:160px;gap:10px}.gallery.large{--card-min:100%}.cardActions{grid-template-columns:1fr}.viewerToolbar{justify-content:flex-start}.viewerToolbar button span{display:none}.toolDivider{flex:0 0 1px}.zoomHint{display:none}.navButton{width:38px;height:52px}.login{padding:26px}}
